<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:AvaloniaClient.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaClient.EditTaskView"
			 x:DataType="vm:EditTaskViewModel">

  <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <Border Width="320"
                    Padding="20"
                    CornerRadius="20"
                    Background="#F2F2F2">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        
        <Border Width="320"
                Padding="20"
                CornerRadius="20"
                Background="#F2F2F2">

            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Addition"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Width="28" Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            Command="{Binding CancelCommand}"/>
                </Grid>

                <TextBox Watermark="Title..." Text="{Binding Title}"/>
                <ComboBox PlaceholderText="Assignee..." />
                <ComboBox PlaceholderText="Tag..." />
                <ComboBox PlaceholderText="Status..." />

                <TextBox Watermark="Description..."
                         AcceptsReturn="True"
                         Height="80"
                         TextWrapping="Wrap"
                         Text="{Binding Description}"/>

                <Button Content="Confirm"
                        HorizontalAlignment="Right"
                        Padding="12,6"
                        Background="#E6E6FA"
                        Foreground="#6C7BFF"
                        CornerRadius="10"
						Command="{Binding SaveCommand}"
						x:Name="SaveButton"/>
            </StackPanel>
        </Border>
    </Grid>
                 </Border>
        </Grid>
</UserControl>
