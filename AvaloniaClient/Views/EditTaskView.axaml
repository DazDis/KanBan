<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:AvaloniaClient.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaClient.EditTaskView"
			 x:DataType="vm:EditTaskViewModel">

  <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <Border Width="320"
                    Padding="20"
                    CornerRadius="20"
                    Background="#F2F2F2">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        
        <Border Width="320"
                Padding="20"
                CornerRadius="20"
                Background="#F2F2F2">

            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Изменить задачу"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
               <Button Content="✕"
                            HorizontalAlignment="Right"
                            Width="28" Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="14"
                            Command="{Binding CancelCommand}"/>

                </Grid>

                <TextBox Watermark="Название..." Text="{Binding Title}"/>

                <ComboBox PlaceholderText="Исполнитель..."
                          ItemsSource="{Binding Teams}"
                          SelectedItem="{Binding SelectedTeam}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

               <TextBlock Text="Теги"/>

                <Border Height="150"
                        BorderThickness="1"
                        CornerRadius="6"
                        BorderBrush="Gray">

                    <ScrollViewer MaxHeight="150"
                                  VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding Labels}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              Content="{Binding Name}" />

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Border>

                <ComboBox PlaceholderText="Статус..."
                          ItemsSource="{Binding Columns}"
                          SelectedItem="{Binding SelectedColumnStatus}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox Watermark="Описание..."
                         AcceptsReturn="True"
                         Height="80"
                         TextWrapping="Wrap"
                         Text="{Binding Description}"/>

                 <TextBlock Text="Цвет задачи"/>

                <ColorPicker Color="{Binding SelectedColor}"/>

                <TextBlock Text="Срок выполнения"/>

                <DatePicker SelectedDate="{Binding Date}"/>

                <TextBlock Text="Время"/>

                <TimePicker SelectedTime="{Binding Time}"/>

                 <Grid>
                    <Button Content="Сохранить"
                            HorizontalAlignment="Center"
                            Padding="12,6"
                            Background="#E6E6FA"
                            Foreground="#6C7BFF"
                            CornerRadius="10"
						    Command="{Binding SaveCommand}"
						    x:Name="SaveButton"/>

                    <Button Content="Удалить"
                            HorizontalAlignment="Right"
                            Padding="12,6"
                            Background="#ffffff"
                            Foreground="#C51D34"
                            CornerRadius="10"
						    Command="{Binding DeleteCommand}"
						    x:Name="DeleteButton"/>
                 </Grid>
                <Border Padding="10">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Журнал изменений"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                
                                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#F5F5F5"
                                                        CornerRadius="6"
                                                        Padding="10"
                                                        Margin="0,5">
                                                    <StackPanel Spacing="5">
                                                        <TextBlock Text="{Binding DisplayText}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Comment}"
                                                                   FontSize="11"
                                                                   Foreground="Gray"
                                                                   IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
            </StackPanel>

        </Border>
    </Grid>
                 </Border>
        </Grid>
</UserControl>