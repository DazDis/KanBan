<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:AvaloniaClient.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="AvaloniaClient.EditTaskView"
             x:DataType="vm:EditTaskViewModel">


        <Grid ColumnDefinitions="1*,2*"
              Margin="20"
              ColumnSpacing="16"
              MinWidth="1300"
              MinHeight="750"
              MaxWidth="1400">

            <!-- ========================================= -->
            <!-- ЖУРНАЛ -->
            <!-- ========================================= -->

            <Border Grid.Column="0"
                    Padding="16"
                    CornerRadius="20"
                    Background="#F2F2F2"
                    IsVisible="{Binding IsHistoryVisible}">

                <Grid RowDefinitions="Auto,*">

                    <TextBlock Text="Журнал изменений"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding History}">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Background="White"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0,0,0,10">

                                        <StackPanel Spacing="6">

                                            <TextBlock Text="{Binding DisplayText}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>

                                            <TextBlock Text="{Binding Comment}"
                                                       FontSize="11"
                                                       Foreground="Gray"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                        </StackPanel>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>

            <!-- ========================================= -->
            <!-- ОСНОВНАЯ ФОРМА -->
            <!-- ========================================= -->

           <Border Grid.Column="1"
        Padding="24"
        CornerRadius="20"
        Background="#F2F2F2"
        MinWidth="700"
        MaxWidth="1400"
        HorizontalAlignment="Stretch">

                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
                      RowSpacing="18">

                    <!-- ========================================= -->
                    <!-- HEADER -->
                    <!-- ========================================= -->

                    <Grid Grid.Row="0"
                          ColumnDefinitions="*,Auto">

                        <TextBlock Text="Изменить задачу"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="✕"
                                Width="32"
                                Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="14"
                                Command="{Binding CancelCommand}"/>

                    </Grid>

                    <!-- ========================================= -->
                    <!-- НАЗВАНИЕ -->
                    <!-- ========================================= -->

                    <TextBox Grid.Row="1"
                             Watermark="Название задачи..."
                             FontSize="15"
                             TextWrapping="NoWrap"
                             HorizontalAlignment="Stretch"
                             Text="{Binding Title}"/>

                    <!-- ========================================= -->
                    <!-- ОСНОВНОЙ КОНТЕНТ -->
                    <!-- ========================================= -->

                    <Grid Grid.Row="2"
      ColumnDefinitions="1*,2.2*"
      ColumnSpacing="24">

                        <!-- ========================================= -->
                        <!-- ЛЕВАЯ КОЛОНКА -->
                        <!-- ========================================= -->

                        <StackPanel Grid.Column="0"
                                    Spacing="16">

                            <!-- Команды -->

                            <StackPanel Spacing="8">

                                <TextBlock Text="Команды"
                                           FontWeight="SemiBold"/>

                                <Border BorderThickness="1"
                                        BorderBrush="#D1D5DB"
                                        CornerRadius="10"
                                        Padding="8"
                                        MinHeight="120"
                                        MaxHeight="160"
                                        Background="White">

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                                        <ItemsControl ItemsSource="{Binding Teams}">

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Border CornerRadius="8"
                                                            Padding="8,5"
                                                            Margin="0,0,0,6"
                                                            Background="{Binding Color}">

                                                        <CheckBox IsChecked="{Binding IsSelected}">

                                                            <CheckBox.Content>
                                                                <TextBlock Text="{Binding Title}"
                                                                           Foreground="White"
                                                                           FontWeight="SemiBold"/>
                                                            </CheckBox.Content>

                                                        </CheckBox>

                                                    </Border>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </ScrollViewer>

                                </Border>

                            </StackPanel>

                            <!-- Пользователи -->

                            <StackPanel Spacing="8">

                                <TextBlock Text="Пользователи"
                                           FontWeight="SemiBold"/>

                                <Border BorderThickness="1"
                                        BorderBrush="#D1D5DB"
                                        CornerRadius="10"
                                        Padding="8"
                                        MinHeight="120"
                                        MaxHeight="160"
                                        Background="White">

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                                        <ItemsControl ItemsSource="{Binding Users}">

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Border CornerRadius="8"
                                                            Padding="8,5"
                                                            Margin="0,0,0,6"
                                                            Background="#F3F4F6">

                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  Content="{Binding FirstName}"/>

                                                    </Border>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </ScrollViewer>

                                </Border>

                            </StackPanel>

                            <!-- Теги -->

                            <StackPanel Spacing="8">

                                <TextBlock Text="Теги"
                                           FontWeight="SemiBold"/>

                                <Border BorderThickness="1"
                                        BorderBrush="#D1D5DB"
                                        CornerRadius="10"
                                        Padding="8"
                                        MinHeight="120"
                                        MaxHeight="160"
                                        Background="White">

                                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                                        <ItemsControl ItemsSource="{Binding Labels}">

                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>

                                                    <Border Padding="8,5"
                                                            Margin="4"
                                                            CornerRadius="8"
                                                            Background="#F9FAFB">

                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  Content="{Binding Name}"/>

                                                    </Border>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>

                                        </ItemsControl>

                                    </ScrollViewer>

                                </Border>

                            </StackPanel>

                        </StackPanel>

                        <!-- ========================================= -->
                        <!-- ПРАВАЯ КОЛОНКА -->
                        <!-- ========================================= -->

                        <StackPanel Grid.Column="1"
                                    Spacing="16">

                            <!-- Статус -->

                            <StackPanel Spacing="6">

                                <TextBlock Text="Статус"
                                           FontWeight="SemiBold"/>

                                <ComboBox PlaceholderText="Выберите статус..."
                                          ItemsSource="{Binding Columns}"
                                          SelectedItem="{Binding SelectedColumnStatus}"
                                          HorizontalAlignment="Stretch">

                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>

                                </ComboBox>

                            </StackPanel>

                            <!-- Описание -->

                            <StackPanel Spacing="6">

                                <TextBlock Text="Описание"
                                           FontWeight="SemiBold"/>

                                <TextBox Watermark="Описание задачи..."
                                         AcceptsReturn="True"
                                         MinHeight="140"
                                         MaxHeight="240"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Stretch"
                                         HorizontalAlignment="Stretch"
                                         Text="{Binding Description}"/>

                            </StackPanel>

                            <!-- Цвет -->

                            <StackPanel Spacing="6">

                                <TextBlock Text="Цвет задачи"
                                           FontWeight="SemiBold"/>

                                <ColorPicker Color="{Binding SelectedColorBrush}"
                                             Width="220"
                                             HorizontalAlignment="Left"/>

                            </StackPanel>

                           <!-- БЛОК: ДАТА / ВРЕМЯ -->
<Border Background="White"
        CornerRadius="10"
        BorderBrush="#D1D5DB"
        BorderThickness="1"
        Padding="12">

   <!-- ДАТА / ВРЕМЯ -->
<StackPanel Spacing="6">

    <TextBlock Text="Дата и время"
               FontWeight="SemiBold"/>

    <!-- ДАТА -->
    <StackPanel Spacing="6">

        <TextBlock Text="Дата выполнения"
                   FontSize="12"
                   Opacity="0.7"/>

        <DatePicker SelectedDate="{Binding Date}"
                    HorizontalAlignment="Stretch"/>
    </StackPanel>

    <!-- ВРЕМЯ -->
    <StackPanel Spacing="6">

        <TextBlock Text="Время"
                   FontSize="12"
                   Opacity="0.7"/>

        <TimePicker SelectedTime="{Binding Time}"
                    HorizontalAlignment="Stretch"/>
    </StackPanel>

</StackPanel>

</Border>

                        </StackPanel>

                    </Grid>

                    <!-- ========================================= -->
                    <!-- ОШИБКА -->
                    <!-- ========================================= -->

                    <TextBlock Grid.Row="3"
                               Text="{Binding Error}"
                               FontSize="11"
                               Foreground="#C51D34"
                               FontWeight="SemiBold"
                               IsVisible="{Binding HaveError}"/>

                    <!-- ========================================= -->
                    <!-- КНОПКИ -->
                    <!-- ========================================= -->

                      <Grid Grid.Row="4"
      ColumnDefinitions="*,Auto"
      ColumnSpacing="12">

    <!-- пустая левая часть (выталкивает всё вправо) -->
    <Grid Grid.Column="0"/>

    <!-- ПРАВАЯ ГРУППА -->
    <StackPanel Grid.Column="1"
                Orientation="Horizontal"
                Spacing="10">

        <!-- Удалить -->
        <Button Content="Удалить"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Command="{Binding DeleteCommand}"
                Background="White"
                Foreground="#C51D34"
                CornerRadius="12"
                FontWeight="SemiBold"
                Height="42"
                Margin="0,0,12,0"/>

        <!-- Журнал -->
        <Button Content="Журнал"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Command="{Binding ToggleHistoryCommand}"
                Background="White"
                Foreground="#6C7BFF"
                CornerRadius="12"
                FontWeight="SemiBold"
                Height="42"/>

        <!-- Сохранить -->
        <Button Content="Сохранить"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Command="{Binding SaveCommand}"
                Background="#E6E6FA"
                Foreground="#6C7BFF"
                CornerRadius="12"
                FontWeight="SemiBold"
                Height="42"/>

    </StackPanel>

</Grid>

                </Grid>

            </Border>

        </Grid>


</UserControl>