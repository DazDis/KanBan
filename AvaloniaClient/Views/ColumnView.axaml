<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaClient.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="AvaloniaClient.ColumnView"
             x:DataType="vm:ColumnViewModel">

    <Grid Background="#f3f4f6">
        
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
            
            <StackPanel Orientation="Horizontal" Margin="20">

                <!-- кнопка +  -->
                <Button Content="＋"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Width="50" Height="50"
                        FontSize="20"
                        Background="#e5e7eb"
                        CornerRadius="12"
                        Command="{Binding AddColumnCommand}"
                        Margin="0,0,20,0"/>

                <!-- СПИСОК КОЛОНОК -->
                <ItemsControl ItemsSource="{Binding Columns}">
                    
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <!-- КОЛОНКА -->
                            <Border Width="280"
                                    Margin="0,0,20,0"
                                    Background="#ffffff"
                                    CornerRadius="16"
                                    Padding="15">

                                <StackPanel>

                                    <!-- ЗАГОЛОВОК -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"/>

                                        <!-- СЧЁТЧИК -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Tasks.Count}"
                                                   Foreground="#9ca3af"
                                                   FontSize="16"/>
                                    </Grid>

                                    <!-- КНОПКА ДОБАВИТЬ ЗАДАЧУ -->
                                    <Button Content="+ Добавить"
                                            Command="{Binding $parent[UserControl].DataContext.AddTaskCommand}"
                                            CommandParameter="{Binding Id}"
                                            Margin="0,0,0,10"
                                            Background="#f3f4f6"
                                            CornerRadius="8"/>

                                    <!-- СПИСОК ЗАДАЧ -->
                                    <ItemsControl ItemsSource="{Binding Tasks}">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>

                                                <!-- КАРТОЧКА ЗАДАЧИ -->
                                                <Border CornerRadius="12"
                                                        Padding="12"
                                                        Margin="0,0,0,10">

                                                    <!-- Цвет карточки -->
                                                    <Border.Styles>
                                                        <Style Selector="Border">
                                                            <Setter Property="Background" Value="#93c5fd"/>
                                                        </Style>
                                                    </Border.Styles>

                                                    <StackPanel>

                                                        <!-- Заголовок -->
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"/>

                                                        <!-- Описание -->
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="11"
                                                                   Foreground="#6b7280"
                                                                   Margin="0,4,0,6"
                                                                   TextWrapping="Wrap"/>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- тег -->
                                                            <TextBlock Text="tag"
                                                                       FontSize="10"
                                                                       Foreground="#374151"/>

                                                            <!-- иконка -->
                                                            <Border Grid.Column="1"
                                                                    Width="24"
                                                                    Height="24"
                                                                    CornerRadius="12"
                                                                    Background="#d9f99d"/>
                                                        </Grid>

                                                        <!-- КНОПКИ -->
                                                        <StackPanel Orientation="Horizontal"
                                                                    Margin="0,8,0,0">
                                                            <Button Content="✎"
                                                                    Width="30"
                                                                    Command="{Binding $parent[UserControl].DataContext.EditTaskCommand}"
                                                                    CommandParameter="{Binding}"/>

                                                            <Button Content="🗑"
                                                                    Width="30"
                                                                    Margin="5,0,0,0"
                                                                    Command="{Binding $parent[UserControl].DataContext.DeleteTaskCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>

                                                    </StackPanel>
                                                </Border>

                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </StackPanel>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>
        </ScrollViewer>


    </Grid>
</UserControl>