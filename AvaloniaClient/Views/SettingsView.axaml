<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaClient.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:dd="using:Avalonia.Xaml.Interactions.DragAndDrop"
             xmlns:local="using:AvaloniaClient.Services"
             mc:Ignorable="d"
             x:Class="AvaloniaClient.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <local:TeamDropHandler x:Key="TeamDropHandler" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *, Auto" Margin="10">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button Content="Назад" Command="{Binding NavigateToColumnCommand}" />
            <Button Content="Удалить БД" Command="{Binding DropDBCommand}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="2*,3*,1.5*" ColumnSpacing="15">
            <!-- ========== КОМАНДЫ ========== -->
            <Border Grid.Column="0" Background="#F0F0F0" CornerRadius="8" Padding="10">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">

        <TextBlock Text="Команды"
                   FontWeight="Bold"
                   FontSize="16" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Content="➕ Добавить" Command="{Binding AddTeamCommand}" />
            <Button Content="🗑 Удалить" Command="{Binding DeleteTeamCommand}" />
            <Button Content="💾 Сохранить" Command="{Binding SaveAllTeamsCommand}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <i:Interaction.Behaviors>
                <dd:ContextDropBehavior Handler="{StaticResource TeamDropHandler}" />
            </i:Interaction.Behaviors>

           <ListBox ItemsSource="{Binding Teams}"
                    SelectedItem="{Binding SelectedTeam, Mode=TwoWay}">

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   ItemWidth="260"
                                   ItemHeight="320" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="250"
                                Height="300"
                                Margin="5"
                                Padding="10"
                                CornerRadius="10"
                                Background="#FFFFFF"
                                BorderBrush="#D0D0D0"
                                BorderThickness="1">
                            <i:Interaction.Behaviors>
                                <dd:ContextDropBehavior Handler="{StaticResource TeamDropHandler}" />
                            </i:Interaction.Behaviors>
                            <StackPanel Spacing="10">

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBox Text="{Binding Title, Mode=TwoWay}"
                                             FontWeight="Bold"
                                             FontSize="16"
                                             BorderThickness="0"
                                             Background="Transparent" />

                                    <Button Grid.Column="1"
                                            Width="36"
                                            Height="36"
                                            CornerRadius="6"
                                            Background="{Binding Color}">
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker Color="{Binding Color, Mode=TwoWay}" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                </Grid>

                                <Border Background="#F7F7F7"
                                        CornerRadius="6"
                                        Padding="1"
                                        MinHeight="220">

                                    <ListBox ItemsSource="{Binding Users}"
                                             Background="Transparent"
                                             BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Весь блок перетаскивается -->
                                                <Border Padding="8"
                                                        Margin="0,0,0,5"
                                                        CornerRadius="6"
                                                        Background="#ECECEC"
                                                        Cursor="Hand">
                                                        <i:Interaction.Behaviors>
                                                            <dd:ContextDragBehavior Context="{Binding}" />
                                                        </i:Interaction.Behaviors>

                                                    <Grid ColumnDefinitions="*,Auto">

                
                                                        <!-- Текст внутри -->
                                                        <TextBlock Text="{Binding FirstName}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="13" />
                                                        <Button Grid.Column="1"
                                                                Content="❌"
                                                                Command="{Binding $parent[UserControl].DataContext.RemoveUserFromTeamCommand}"
                                                                CommandParameter="{Binding}" />
                                                     

                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                </Border>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ListBox>
        </ScrollViewer>

    </Grid>
</Border>

            <!-- ========== ПОЛЬЗОВАТЕЛИ ========== -->
          <Border Grid.Column="1"
        Background="#F0F0F0"
        CornerRadius="8"
        Padding="10">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">

        <TextBlock Text="Пользователи"
                   FontWeight="Bold"
                   FontSize="16"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Content="➕ Добавить" Command="{Binding AddUserCommand}" />
            <Button Content="🗑 Удалить" Command="{Binding DeleteUserCommand}" />
            <Button Content="💾 Сохранить" Command="{Binding SaveAllUsersCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="2" 
          ItemsSource="{Binding Users}" 
          SelectedItem="{Binding SelectedUser}" 
          AutoGenerateColumns="False">
    <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="30">
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <Border Background="Transparent" 
                            Cursor="Hand"
                            Padding="4">
                        <i:Interaction.Behaviors>
                            <dd:ContextDragBehavior Context="{Binding}" />
                        </i:Interaction.Behaviors>
                        <PathIcon Data="{StaticResource DragHandleIcon}" 
                                  Foreground="Gray" />
                    </Border>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- ID (только для чтения) -->
        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True" />

        <!-- Имя (с редактированием и Drag&Drop) -->
        <DataGridTemplateColumn Header="Имя" Width="*">
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <!-- Режим просмотра -->
                    <Border Background="Transparent" Padding="2">
                        <i:Interaction.Behaviors>
                            <dd:ContextDragBehavior Context="{Binding}" />
                        </i:Interaction.Behaviors>
                        <TextBlock Text="{Binding FirstName}" VerticalAlignment="Center" />
                    </Border>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                    <!-- Режим редактирования -->
                    <TextBox Text="{Binding FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="2"
                             BorderThickness="1"
                             BorderBrush="Gray" />
                </DataTemplate>
            </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>

        <!-- Фамилия (с редактированием и Drag&Drop) -->
        <DataGridTemplateColumn Header="Фамилия" Width="*">
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <Border Background="Transparent" Padding="2">
                        <i:Interaction.Behaviors>
                            <dd:ContextDragBehavior Context="{Binding}" />
                        </i:Interaction.Behaviors>
                        <TextBlock Text="{Binding LastName}" VerticalAlignment="Center" />
                    </Border>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                    <TextBox Text="{Binding LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="2"
                             BorderThickness="1"
                             BorderBrush="Gray" />
                </DataTemplate>
            </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>

        <!-- Email (стандартная колонка с редактированием) -->
        <DataGridTextColumn Header="Email" Binding="{Binding Email, Mode=TwoWay}" Width="*" />
        
    </DataGrid.Columns>
</DataGrid>

    </Grid>
</Border>

            <!-- ========== ТЕГИ ========== -->
<Border Grid.Column="2"
        Background="#F0F0F0"
        CornerRadius="8"
        Padding="10">

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">

        <TextBlock Text="Теги"
                   FontWeight="Bold"
                   FontSize="16"/>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button Content="➕ Добавить" Command="{Binding AddLabelCommand}" />
            <Button Content="🗑 Удалить" Command="{Binding DeleteLabelCommand}" />
            <Button Content="💾 Сохранить" Command="{Binding SaveAllLabelsCommand}" />
        </StackPanel>

        <!-- УБРАЛ MaxHeight -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Labels}"
                 SelectedItem="{Binding SelectedLabel}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                        <Button Grid.Column="1"
                                Width="40"
                                Height="40"
                                Margin="8,0,0,0"
                                CornerRadius="4"
                                Background="{Binding Color}">
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker Color="{Binding Color, Mode=TwoWay}" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>
</Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Message}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
    </Grid>
</UserControl>