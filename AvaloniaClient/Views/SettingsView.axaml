<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaClient.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:dd="using:Avalonia.Xaml.Interactions.DragAndDrop"
             xmlns:local="using:AvaloniaClient.Services"
             mc:Ignorable="d"
             x:Class="AvaloniaClient.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <local:TeamDropHandler x:Key="TeamDropHandler" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *, Auto" Margin="10">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <Button Content="Назад" Command="{Binding NavigateToColumnCommand}" />
            <Button Content="Удалить БД" Command="{Binding DropDBCommand}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="2*,3*,1.5*" ColumnSpacing="15">
            <!-- ========== КОМАНДЫ ========== -->
            <Border Grid.Column="0" Background="#F0F0F0" CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="Команды" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                        <Button Content="➕ Добавить" Command="{Binding AddTeamCommand}" />
                        <Button Content="🗑 Удалить" Command="{Binding DeleteTeamCommand}" />
                        <Button Content="💾 Сохранить" Command="{Binding SaveAllTeamsCommand}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Teams}"
                             SelectedItem="{Binding SelectedTeam}"
                             MaxHeight="400" />
                </StackPanel>
            </Border>

            <!-- ========== ПОЛЬЗОВАТЕЛИ ========== -->
            <Border Grid.Column="1" Background="#F0F0F0" CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="Пользователи" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                        <Button Content="➕ Добавить" Command="{Binding AddUserCommand}" />
                        <Button Content="🗑 Удалить" Command="{Binding DeleteUserCommand}" />
                        <Button Content="💾 Сохранить" Command="{Binding SaveAllUsersCommand}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" IsReadOnly="True" />
                            <DataGridTextColumn Header="Имя" Binding="{Binding FirstName, Mode=TwoWay}" Width="*" />
                            <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName, Mode=TwoWay}" Width="*" />
                            <DataGridTextColumn Header="Email" Binding="{Binding Email, Mode=TwoWay}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ========== ТЕГИ ========== -->
            <Border Grid.Column="2" Background="#F0F0F0" CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="Теги" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                        <Button Content="➕ Добавить" Command="{Binding AddLabelCommand}" />
                        <Button Content="🗑 Удалить" Command="{Binding DeleteLabelCommand}" />
                        <Button Content="💾 Сохранить" Command="{Binding SaveAllLabelsCommand}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Labels}"
                             SelectedItem="{Binding SelectedLabel}"
                             MaxHeight="400">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                    <Button Grid.Column="1" Width="40" Height="40" Margin="8,0,0,0" CornerRadius="4"
                                            Background="{Binding Color}">
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorPicker Color="{Binding Color, Mode=TwoWay}" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Message}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
    </Grid>
</UserControl>