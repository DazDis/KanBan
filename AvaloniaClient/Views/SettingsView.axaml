<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaClient.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="AvaloniaClient.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <Grid ColumnDefinitions="2*,3*,1.5*" Margin="10">

    <!-- ЛЕВО: команды -->
    <ScrollViewer Grid.Column="0">
      <ItemsControl ItemsSource="{Binding Teams}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="200" Margin="5" Padding="10" Background="#DDD">

              <StackPanel>

                <!-- Заголовок -->
                <DockPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="Bold"/>

                  <Button DockPanel.Dock="Right"
                          Width="20"
                          Height="20"
                          Background="{Binding ColorTeam}">

                    <Button.Flyout>
                      <Flyout>
                        <ColorPicker Color="{Binding ColorTeam, Mode=TwoWay}"/>
                      </Flyout>
                    </Button.Flyout>

                  </Button>
                </DockPanel>

                <!-- Участники -->
                <ItemsControl ItemsSource="{Binding Users}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding FirstName}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Добавление -->
                <ComboBox ItemsSource="{Binding DataContext.Users, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          SelectedItem="{Binding SelectedUserToAdd}"/>

                <Button Content="Добавить"
                        Command="{Binding AddUserToTeamCommand}"/>

              </StackPanel>

            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- ЦЕНТР: пользователи -->
    <Border Grid.Column="1" Background="#F5F5F5" Padding="10" Margin="5">
      <DockPanel>

        <TextBlock Text="Пользователи" DockPanel.Dock="Top"/>

        <DataGrid ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False">

          <DataGrid.Columns>
            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
            <DataGridTextColumn Header="Имя" Binding="{Binding FirstName, Mode=TwoWay}" Width="*"/>
            <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName, Mode=TwoWay}" Width="*"/>
            <DataGridTextColumn Header="Email" Binding="{Binding Email, Mode=TwoWay}" Width="*"/>
          </DataGrid.Columns>

        </DataGrid>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Margin="0,10,0,0">
          <Button Content="Добавить" Command="{Binding AddUserCommand}"/>
          <Button Content="Удалить"
                  Command="{Binding DeleteUserCommand}"
                  CommandParameter="{Binding SelectedUser}"/>
        </StackPanel>

      </DockPanel>
    </Border>

    <!-- ПРАВО: права -->
    <Border Grid.Column="2" Background="#EEE" Padding="10" Margin="5">

      <DockPanel>

        <TextBlock Text="Права" DockPanel.Dock="Top"/>

        <StackPanel Orientation="Horizontal" Margin="0,5">
          <Button Content="Добавить" Command="{Binding AddLabelCommand}"/>
          <Button Content="Удалить"
                  Command="{Binding DeleteLabelCommand}"
                  CommandParameter="{Binding SelectedLabel}"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Labels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>

              <Grid ColumnDefinitions="*,Auto" Margin="0,5">

                <TextBox Text="{Binding Name, Mode=TwoWay}"/>

                <Button Grid.Column="1"
                        Width="30"
                        Height="30"
                        Margin="5,0,0,0"
                        Background="{Binding Color}">

                  <Button.Flyout>
                    <Flyout>
                      <ColorPicker Color="{Binding Color, Mode=TwoWay}"/>
                    </Flyout>
                  </Button.Flyout>

                </Button>

              </Grid>

            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </DockPanel>

    </Border>

  </Grid>
</UserControl>