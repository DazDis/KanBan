<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaClient.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaClient.MVPColumnView"
             x:DataType="vm:ColumnViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
            
            <!-- Столбец 1: To Do -->
            <Border Width="280" Margin="10" Background="#f5f5f5" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="📋 To Do" FontSize="16" FontWeight="Bold" Margin="10,10,10,5"/>
                    <Button Content="+ Добавить задачу" Command="{Binding AddTaskCommand}" 
                            CommandParameter="{Binding Columns[0].Id}" Margin="10,0,10,10"
                            HorizontalAlignment="Stretch"/>
                    <ListBox ItemsSource="{Binding Columns[0].Tasks}" 
                             SelectedItem="{Binding SelectedTask}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="4" Margin="5" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" 
                                                   TextWrapping="Wrap" Foreground="Gray"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Button Content="✎" Command="{Binding $parent[UserControl].DataContext.EditTaskCommand}" 
                                                    CommandParameter="{Binding}" Width="30"/>
                                            <Button Content="🗑" Command="{Binding $parent[UserControl].DataContext.DeleteTaskCommand}" 
                                                    CommandParameter="{Binding}" Width="30" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            
            <!-- Столбец 2: In Progress -->
            <Border Width="280" Margin="10" Background="#f5f5f5" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="🔄 In Progress" FontSize="16" FontWeight="Bold" Margin="10,10,10,5"/>
                    <Button Content="+ Добавить задачу" Command="{Binding AddTaskCommand}" 
                            CommandParameter="{Binding Columns[1].Id}" Margin="10,0,10,10"/>
                    <ListBox ItemsSource="{Binding Columns[1].Tasks}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="4" Margin="5" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="Gray"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Button Content="✎" Command="{Binding $parent[UserControl].DataContext.EditTaskCommand}" CommandParameter="{Binding}" Width="30"/>
                                            <Button Content="🗑" Command="{Binding $parent[UserControl].DataContext.DeleteTaskCommand}" CommandParameter="{Binding}" Width="30" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            
            <!-- Столбец 3: Review -->
            <Border Width="280" Margin="10" Background="#f5f5f5" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="📝 Review" FontSize="16" FontWeight="Bold" Margin="10,10,10,5"/>
                    <Button Content="+ Добавить задачу" Command="{Binding AddTaskCommand}" 
                            CommandParameter="{Binding Columns[2].Id}" Margin="10,0,10,10"/>
                    <ListBox ItemsSource="{Binding Columns[2].Tasks}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="4" Margin="5" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="Gray"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Button Content="✎" Command="{Binding $parent[UserControl].DataContext.EditTaskCommand}" CommandParameter="{Binding}" Width="30"/>
                                            <Button Content="🗑" Command="{Binding $parent[UserControl].DataContext.DeleteTaskCommand}" CommandParameter="{Binding}" Width="30" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            
            <!-- Столбец 4: Done -->
            <Border Width="280" Margin="10" Background="#f5f5f5" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="✅ Done" FontSize="16" FontWeight="Bold" Margin="10,10,10,5"/>
                    <Button Content="+ Добавить задачу" Command="{Binding AddTaskCommand}" 
                            CommandParameter="{Binding Columns[3].Id}" Margin="10,0,10,10"/>
                    <ListBox ItemsSource="{Binding Columns[3].Tasks}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="4" Margin="5" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" Foreground="Gray"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Button Content="✎" Command="{Binding $parent[UserControl].DataContext.EditTaskCommand}" CommandParameter="{Binding}" Width="30"/>
                                            <Button Content="🗑" Command="{Binding $parent[UserControl].DataContext.DeleteTaskCommand}" CommandParameter="{Binding}" Width="30" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
